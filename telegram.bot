// Telegram Bot for TNEH Shortcut URL API
const TelegramBot = require('node-telegram-bot-api');
const fetch = require('node-fetch');

// Replace with your actual bot token from @BotFather
const TOKEN = '8862913874:AAGehnjcz_fMlDtswvyXsrFPWbiqErZavK8';
const API_BASE = 'https://tnehshotcurt.onrender.com';

const bot = new TelegramBot(TOKEN, { polling: true });

// Command: /start
bot.onText(/\/start/, (msg) => {
  const chatId = msg.chat.id;
  const welcomeMessage = `
🔗 *Welcome to TNEH URL Shortener Bot!*

I can shorten your URLs instantly using our professional API.

*Commands:*
/shorten <url> - Shorten a URL
/shorten <url> <key> - Shorten with custom key
/check <key> - Check if key exists
/help - Show this help message

*Examples:*
/shorten https://google.com
/shorten https://google.com mygoogle

Try it now! 🚀
  `;
  
  bot.sendMessage(chatId, welcomeMessage, { parse_mode: 'Markdown' });
});

// Command: /help
bot.onText(/\/help/, (msg) => {
  const chatId = msg.chat.id;
  bot.sendMessage(chatId, 
    `*TNEH URL Shortener Bot Commands*

/shorten <url> - Create short URL
/shorten <url> <key> - Create with custom key
/check <key> - Check key availability
/start - Restart the bot

*Example Usage:*
/shorten https://example.com/very/long/url
/shorten https://example.com mycustomkey

Get your API key at: ${API_BASE}`,
    { parse_mode: 'Markdown' }
  );
});

// Command: /shorten
bot.onText(/\/shorten (.+)/, async (msg, match) => {
  const chatId = msg.chat.id;
  const input = match[1].trim().split(' ');
  const url = input[0];
  const customKey = input[1];
  
  // Validate URL
  if (!url.match(/^https?:\/\//)) {
    return bot.sendMessage(chatId, '❌ Please provide a valid URL starting with http:// or https://');
  }
  
  try {
    let endpoint;
    if (customKey) {
      // Create with custom key
      endpoint = `${API_BASE}/api/create-key?url=${encodeURIComponent(url)}&key=${encodeURIComponent(customKey)}`;
    } else {
      // Create without custom key
      endpoint = `${API_BASE}/api/apikey?apikey=telegram&url=${encodeURIComponent(url)}`;
    }
    
    const response = await fetch(endpoint);
    const data = await response.json();
    
    if (response.ok) {
      const message = `
✅ *URL Shortened Successfully!*

🔗 *Original:* ${data.originalUrl}
📎 *Short URL:* ${data.shortUrl}
${data.customUrl ? `🎯 *Custom URL:* ${data.customUrl}` : ''}
${data.key ? `🔑 *Key:* ${data.key}` : ''}

✨ Share your shortened URL anywhere!
      `;
      bot.sendMessage(chatId, message, { parse_mode: 'Markdown' });
    } else {
      bot.sendMessage(chatId, `❌ Error: ${data.error || 'Failed to shorten URL'}`);
    }
  } catch (error) {
    bot.sendMessage(chatId, `❌ API Error: ${error.message}`);
  }
});

// Command: /check
bot.onText(/\/check (.+)/, async (msg, match) => {
  const chatId = msg.chat.id;
  const key = match[1].trim();
  
  try {
    const response = await fetch(`${API_BASE}/api/check?key=${encodeURIComponent(key)}`);
    const data = await response.json();
    
    if (data.exists) {
      bot.sendMessage(chatId, 
        `🔍 *Key Status:* EXISTS\n\n📌 *Key:* ${data.key}\n🔗 *Original URL:* ${data.originalUrl}\n📅 *Created:* ${new Date(data.createdAt).toLocaleString()}`,
        { parse_mode: 'Markdown' }
      );
    } else {
      bot.sendMessage(chatId, `🔍 Key "${key}" is *AVAILABLE* for use!`, { parse_mode: 'Markdown' });
    }
  } catch (error) {
    bot.sendMessage(chatId, `❌ Error checking key: ${error.message}`);
  }
});

console.log('🤖 TNEH Telegram Bot is running...');
